# ============================================================
# PROVIDER SETTINGS
# Wybierz dostawcę dla VLM (OCR) i LLM (RAG)
# Opcje: "groq" | "ollama"
# ============================================================
VLM_PROVIDER=groq
LLM_PROVIDER=groq

# ============================================================
# GROQ API (używany gdy VLM_PROVIDER=groq lub LLM_PROVIDER=groq)
# Klucz API: https://console.groq.com
# ============================================================
GROQ_API_KEY=your_groq_api_key_here

# Model VLM używany przez Groq do odczytu obrazów faktur
# Dostępne modele vision na Groq:
# - meta-llama/llama-4-scout-17b-16e-instruct  (najlepszy, obsługuje obrazy)
# - meta-llama/llama-4-maverick-17b-128e-instruct
GROQ_VLM_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Model LLM używany przez Groq do generowania odpowiedzi RAG
# Dostępne modele tekstowe na Groq:
# - llama-3.3-70b-versatile  (najlepszy, wolniejszy)
# - llama-3.1-8b-instant     (szybszy, mniejszy)
# - mixtral-8x7b-32768       (dobry do długich kontekstów)
GROQ_LLM_MODEL=llama-3.3-70b-versatile

# ============================================================
# OLLAMA (używany gdy VLM_PROVIDER=ollama lub LLM_PROVIDER=ollama)
# Ollama musi być uruchomiona lokalnie
# ============================================================
OLLAMA_BASE_URL=http://localhost:11434

# Model VLM w Ollama (musi obsługiwać obrazy - vision model)
# Pobierz: ollama pull qwen2-vl
OLLAMA_VLM_MODEL=qwen2-vl

# Model LLM w Ollama do generowania odpowiedzi RAG
# Pobierz: ollama pull mistral:7b  (masz już zainstalowany)
OLLAMA_LLM_MODEL=mistral:7b

# ============================================================
# QDRANT (baza wektorowa)
# ============================================================
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=documents

# ============================================================
# EMBEDDINGS (zawsze lokalnie — sentence-transformers)
# ============================================================
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# ============================================================
# APLIKACJA
# ============================================================
APP_HOST=0.0.0.0
APP_PORT=8000
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10